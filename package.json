{
  "name": "catatui",
  "version": "0.5.1",
  "description": "MSU CatChat coding agent for the terminal, built on pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "bin": {
    "catatui": "bin/catatui.js"
  },
  "files": [
    "bin",
    "src/ts",
    "themes",
    "skills",
    "assets/bobcat-head.png",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./src/ts/index.ts"
    ],
    "themes": [
      "./themes"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "typebox": "1.3.27"
  },
  "author": {
    "name": "Montana State University"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msu/catatui.git"
  },
  "homepage": "https://github.com/msu/catatui"
}
