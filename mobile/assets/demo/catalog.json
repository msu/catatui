  "outlines": {
    "CSCI 246": "Logic, proof methods, sets, relations, induction, counting, and graphs.",
    "CSCI 305": "Syntax and semantics, types, scope, functional and logic programming, and how interpreters work.",
    "CSCI 338": "Finite automata, regular and context-free languages, Turing machines, decidability, and complexity.",
    "CSCI 366": "Machine-level programs, memory, processes, and how the operating system runs code.",
    "CSCI 440": "The relational model, SQL, schema design, transactions, and indexes.",
    "CSCI 446": "Search, logic and knowledge representation, planning, probability, and learning.",
    "CSCI 447": "Supervised and unsupervised learning, model selection, and neural networks.",
    "CSCI 460": "Processes, threads, scheduling, memory management, file systems, and concurrency.",
    "CSCI 468": "Lexing, parsing, type checking, intermediate code, and code generation. The class builds a compiler.",
    "CSCI 476": "Threat models, software and network attacks, cryptography in practice, and secure design.",
    "CSCI 491": "Specifications, Hoare logic, model checking, SMT solvers, and a proof assistant. Students verify small programs.",
    "M 242": "How to read and write proofs: logic, sets, functions, induction, and relations.",
    "PHL 236": "Propositional and predicate logic, formal proofs, and the limits of formal systems.",
    "BIOB 160": "Cells, energy, genetics, and molecular biology, with a lab.",
    "BIOB 170": "Evolution, the diversity of life, and ecology, with a lab.",
    "BIOB 375": "Inheritance, gene structure and function, and population genetics.",
    "BIOM 360": "Bacteria, viruses, and the immune response, with a lab.",
    "BCH 380": "Proteins, enzymes, metabolism, and nucleic acids.",
    "CHMY 141": "Atoms, bonding, reactions, stoichiometry, and thermochemistry, with a lab.",
    "CHMY 143": "Kinetics, equilibrium, acids and bases, and electrochemistry, with a lab.",
    "CHMY 321": "Structure, reactions, and mechanisms of carbon compounds, with a lab.",
    "CHMY 323": "More reactions and mechanisms, spectroscopy, and biomolecules, with a lab.",
    "PHSX 220": "Mechanics: motion, forces, energy, and momentum, with a lab.",
    "PHSX 222": "Electric and magnetic fields, circuits, and waves, with a lab.",
    "STAT 216": "Data, probability, estimation, and tests of hypotheses.",
    "STAT 332": "Probability and statistics for scientists and engineers.",
    "ANSC 100": "Livestock and companion animals: breeds, nutrition, health, and the animal industry.",
    "ANSC 320": "Feeds, digestion, and nutrient requirements of animals.",
    "WRIT 101": "College writing: argument, research, and revision.",
    "COMX 111": "Public speaking and communication."
  }
